{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/public", "!!**/dist", "!!**/build"]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "attributePosition": "multiline",
    "includes": ["**", "!**/public", "!!**/dist", "!!**/build"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "includes": ["**", "!**/public", "!!**/dist", "!!**/build"],
    "domains": {
      "react": "recommended",
      "next": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } }
}
